# Copy this file to .env and fill in real values.
# NEVER commit a real .env file — it is in .gitignore.
# The provider key is optional: without it the gateway runs in mock mode.

# Port the server listens on (default 3000)
PORT=3000

# Real LLM provider key — server-side only, never sent to callers.
# Leave empty to run in mock mode.
OPENAI_API_KEY=

# OpenAI-compatible provider base URL (default https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Token for the admin endpoints (POST/GET /admin/keys).
# Change this to a long random value before deploying.
ADMIN_TOKEN=change-me-to-a-long-random-token

# Where the SQLite database file lives (default data/gateway.db)
DATABASE_PATH=data/gateway.db
